# Environment for the adaptive-data-lake-producer INGESTION SERVICE
# (ingestion/src/main/resources/application.yml reads these — see MinioProperties).
#
# Copy this file's values into your shell (or an `.env` the ingestion service
# loads) before running `mvn spring-boot:run` from adaptive-data-lake-producer/ingestion.
# Do NOT commit a copy of this with real values if your box is ever exposed
# beyond your private network — see infra/TROUBLESHOOTING.md and
# infra/.env.example for why the defaults below are fine for a private-network
# deployment only.

# Kafka stays LOCAL — only start `zookeeper`, `kafka`, `kafka-ui` from
# adaptive-data-lake-producer/producers/docker-compose.yml. Do NOT start that
# compose file's `minio` service; the whole point of this integration is that
# storage/query live on the Ryzen box, not on this machine.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Ryzen box MinIO, over Tailscale. Replace the IP if infra/RESOURCES.md's
# documented Tailscale IP ever changes (re-check with `tailscale status`).
MINIO_ENDPOINT=http://YOUR_TRINO_HOST:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET

# Dedicated bucket for ingestion output, separate from the `warehouse` bucket
# that infra/TROUBLESHOOTING.md documents as Hive Metastore's managed-table
# default. The ingestion service auto-creates this bucket on startup if it
# doesn't exist yet (MinioConfig.ensureBucket) — no manual MinIO console step
# needed, unlike `warehouse`.
MINIO_BUCKET=lakehouse-events
