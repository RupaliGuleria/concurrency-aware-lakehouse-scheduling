# Local-only dev credentials for the Trino/MinIO/Hive-metastore stack.
# Copy this file to `.env` and change every value below before starting the
# stack. These are placeholders, not working credentials.
#
# metastore-site.xml and trino/catalog/hive.properties are static files that
# docker-compose does NOT substitute variables into — if you change the
# values here, update those two files to match by hand (see the NOTE at the
# top of metastore-site.xml).

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET

METASTORE_DB_USER=hive
METASTORE_DB_PASSWORD=CHANGE_ME_HIVE_PASSWORD
